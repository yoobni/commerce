# Staging environment template
# Next.js 빌드 시 NODE_ENV=production이 강제됨
# 스테이징 서버의 .env.production.local 에 복사해서 사용 (절대 커밋 금지)

NEXT_PUBLIC_APP_ENV=staging

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://STAGING-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://staging.ravidog.com
NEXT_PUBLIC_APP_VERSION=staging

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# ─── Payments (테스트 키 사용) ────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Internationalization ─────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ko,ja,de

# ─── Feature Flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_COMMUNITY=true
NEXT_PUBLIC_FEATURE_WISHLIST=true
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_POINTS=false
NEXT_PUBLIC_FEATURE_COUPONS=false

# ─── CDN / Storage ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_URL=https://STAGING-PROJECT-ID.supabase.co/storage/v1/object/public

# ─── Geo / Currency ──────────────────────────────────────────────────────────
GEO_API_KEY=
