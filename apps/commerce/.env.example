# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon/public key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service role key (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical URL used for SEO, og:image, etc.
NEXT_PUBLIC_SITE_URL=https://ravidog.com
# App version — injected into analytics events
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Analytics ───────────────────────────────────────────────────────────────
# Google Tag Manager (optional — add to layout.tsx head)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Mixpanel (optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Amplitude (optional)
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Stripe (if using Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Internationalization ────────────────────────────────────────────────────
# Default locale (en | ko | ja | de)
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Supported locales (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ko,ja,de

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to 'true' to enable; anything else = disabled
NEXT_PUBLIC_FEATURE_COMMUNITY=true
NEXT_PUBLIC_FEATURE_WISHLIST=true
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_POINTS=false
NEXT_PUBLIC_FEATURE_COUPONS=false

# ─── CDN / Storage ───────────────────────────────────────────────────────────
# Supabase storage public URL base (usually same as SUPABASE_URL/storage/v1/object/public)
NEXT_PUBLIC_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public

# ─── Social OAuth ────────────────────────────────────────────────────────────
# Google OAuth — enable in Supabase dashboard → Authentication → Providers → Google
# (no additional env vars needed; client_id/secret configured in Supabase)

# Kakao OAuth — enable in Supabase dashboard → Authentication → Providers → Kakao
# (no additional env vars needed; configured in Supabase)

# Twitter/X OAuth — enable in Supabase dashboard → Authentication → Providers → Twitter
# (no additional env vars needed; configured in Supabase)

# Naver OAuth — custom flow (Naver is not a native Supabase provider)
# Register app at https://developers.naver.com → Application → Register
# Set callback URL to: {SITE_URL}/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Geo / Currency ──────────────────────────────────────────────────────────
# IP geolocation API key (e.g. ipapi.co, ipinfo.io) — used to detect user country
GEO_API_KEY=
