# ─── Environment ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

# ─── Supabase (local — run: npx supabase start) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqHBJ5UQJPvDy7Vm2xFWJFaJ0K5ywpBec
# SUPABASE_SERVICE_ROLE_KEY → .env.local (never commit)

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=dev

# ─── Analytics (disabled in dev) ─────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# ─── Payments (test keys — secret goes in .env.local) ─────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# STRIPE_SECRET_KEY → .env.local
# STRIPE_WEBHOOK_SECRET → .env.local

# ─── Internationalization ─────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=ko
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ko,ja,de

# ─── Feature Flags (all on in dev) ───────────────────────────────────────────
NEXT_PUBLIC_FEATURE_COMMUNITY=true
NEXT_PUBLIC_FEATURE_WISHLIST=true
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_POINTS=true
NEXT_PUBLIC_FEATURE_COUPONS=true

# ─── CDN / Storage ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_URL=http://localhost:54321/storage/v1/object/public

# ─── Geo / Currency ──────────────────────────────────────────────────────────
GEO_API_KEY=
