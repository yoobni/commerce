# ─── Environment ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

# ─── Supabase (local — run: npx supabase start) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# SUPABASE_SERVICE_ROLE_KEY → .env.local (never commit)

# ─── Admin ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# ADMIN_JWT_SECRET → .env.local (never commit; use: openssl rand -base64 32)
