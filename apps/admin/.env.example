# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# service role key (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin Auth ──────────────────────────────────────────────────────────────
# JWT secret for signing admin session cookies (min 32 chars random string)
# Generate: openssl rand -base64 32
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─── Payment Adapter ─────────────────────────────────────────────────────────
# 'mock' = 어드민 버튼으로 수동 결제/배송 처리. 'real' = 실제 PG 어댑터 필요.
PAYMENT_MODE=mock
