{
  "name": "commerce",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:commerce": "npm -w apps/commerce run dev",
    "dev:admin": "npm -w apps/admin run dev",
    "build:commerce": "npm -w apps/commerce run build",
    "build:admin": "npm -w apps/admin run build",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint --workspaces -- --fix",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "i18n:qa": "npx tsx scripts/i18n-qa.ts",
    "i18n:qa:strict": "npx tsx scripts/i18n-qa.ts --strict --fix-hint"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
